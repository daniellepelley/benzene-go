# Build context MUST be the repo root (this example imports sibling modules via go.work):
#   docker build -f examples/k8s-helloworld/Dockerfile.sqsworker -t k8s-helloworld-sqsworker .

FROM golang:1.24 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/sqsworker ./examples/k8s-helloworld/sqsworker

# A worker has no inbound listener - the same minimal static base as the api image.
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/sqsworker /sqsworker
ENTRYPOINT ["/sqsworker"]
