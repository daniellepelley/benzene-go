# Build context MUST be the repo root (this example imports sibling modules via go.work):
#   docker build -f examples/k8s-helloworld/Dockerfile.kafkaworker -t k8s-helloworld-kafkaworker .

FROM golang:1.24 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/kafkaworker ./examples/k8s-helloworld/kafkaworker

# A worker has no inbound listener - the same minimal static base as the api image.
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/kafkaworker /kafkaworker
ENTRYPOINT ["/kafkaworker"]
