# Build context MUST be the repo root (this example imports sibling modules via go.work):
#   docker build -f examples/k8s-helloworld/Dockerfile.api -t k8s-helloworld-api .

FROM golang:1.24 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api ./examples/k8s-helloworld/api

# The HTTP leg's only contract is "listen on $PORT" - a minimal static base is enough.
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/api /api
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/api"]
