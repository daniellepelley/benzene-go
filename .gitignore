# Go build artifacts
/bin/
*.exe
*.test
*.out
coverage.txt
coverage.html

# Stray example binaries: `go build ./examples/<name>` run from the repo root drops an
# extension-less binary named <name> here. These are build output, never source. Anchored to
# the root so the examples/<name>/ source directories are unaffected.
/helloworld
/mesh-helloworld
/aws-lambda-helloworld
/aws-dynamodb-helloworld
/azure-functions-helloworld
/gcp-cloudrun-helloworld
/gcp-pubsub-helloworld
/http-helloworld

# Stray example binaries for the own-module examples: `go build` run inside examples/<id>/ drops
# an extension-less binary named <id> in that dir (the module boundary keeps it out of the
# root-anchored ignores above). Build output, never source.
/examples/grpc-helloworld/grpc-helloworld
/examples/kafka-helloworld/kafka-helloworld
/examples/opentelemetry-helloworld/opentelemetry-helloworld

# Stray template binaries: `go build` run inside templates/<id>/ drops an extension-less
# binary named <id> in that dir. Build output, never source.
/templates/aws-apigateway/aws-apigateway
/templates/aws-sqs/aws-sqs

# IDE
.idea/
.vscode/

# OS
.DS_Store
